# EmailJS Service Configuration
# Create a free account at https://www.emailjs.com/ (200 free emails/month)
# 1. Service ID: Created under 'Email Services' tab (e.g., service_xxxxxxx)
# 2. Template ID: Created under 'Email Templates' tab (e.g., template_xxxxxxx)
# 3. Public Key: Found under Account > API Keys (e.g., xxxxxxxxxxxxxxx)

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
